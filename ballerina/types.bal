    string description?;
    # Pauses the promotional code
    @jsondata:Name {value: "paused_flag"}
    boolean pausedFlag?;
    # The type of discount code to use for the event
    @jsondata:Name {value: "discount_code_type"}
    string discountCodeType?;
    # The date the promotional code starts. ISO format
    @jsondata:Name {value: "start_time"}
    string startTime?;
    # Total number of promotional codes to accept
    @jsondata:Name {value: "quantity_total"}
    int:Signed32 quantityTotal?;
    # Status display labels with display text and translation key
    @jsondata:Name {value: "status_labels"}
    StatusDisplayLabelDto[] statusLabels?;
    # The name of the promotional code
    string name;
    # Indicates a time limit applies to the promotional code
    @jsondata:Name {value: "time_limit_flag"}
    boolean timeLimitFlag?;
    # The ID to use for the promotion code
    string id?;
    # The promotional discount percentage to apply for the promotional code
    @jsondata:Name {value: "discount_percent"}
    int:Signed32 discountPercent?;
    # Delete time of the promo code. ISO format
    @jsondata:Name {value: "deleted_time"}
    string deletedTime?;
    # List of items associated with this promo code
    ItemSummaryDto[] items?;
    # Total number of promotional codes available for use
    @jsondata:Name {value: "quantity_available"}
    int:Signed32 quantityAvailable?;
    # The status of the promo code
    string status?;
};

