# Describes a post to a single social profile, including the target profile and its current status on that network
public type ProfilePostProfileDto record {
    # The status of the post activity for this profile
    @jsondata:Name {value: "campaign_activity_status"}
    string campaignActivityStatus?;
    # The activity's timestamp. For <code>SCHEDULED</code> activities, this is typically the same as the scheduled publish time; otherwise, it is the last-modified timestamp
    @jsondata:Name {value: "campaign_activity_status_date"}
    string campaignActivityStatusDate?;
    # The display name of the profile
    @jsondata:Name {value: "profile_name"}
    string profileName?;
    # The campaign activity ID for this post on the specified profile. Generated by the server on creation. When updating a post, existing profile entries should include their original <code>campaign_activity_id</code>
    @jsondata:Name {value: "campaign_activity_id"}
    string campaignActivityId?;
    # The permalink URL to the published post on the social network. Only set when the status is <code>DONE</code>
    @jsondata:Name {value: "post_url"}
    string postUrl?;
    # The URL of the profile's image. This image may become stale and is only refreshed when retrieving profiles with <code>include=accessible</code>
    @jsondata:Name {value: "image_url"}
    string imageUrl?;
    # The unique identifier for the profile to post to. Use the <code>profile_id</code> from <code>GET /social/profiles</code>
    @jsondata:Name {value: "profile_id"}
    string profileId;
    # The human-readable username of the account that owns this profile
    @jsondata:Name {value: "account_username"}
    string accountUsername?;
    # The social network's reference for this post. Only set when the status is <code>DONE</code>
    @jsondata:Name {value: "network_post_id"}
    string networkPostId?;
    # A human-readable message describing the current status of the post activity. Can be a generic Constant Contact message or a specific message reported by the social network
    @jsondata:Name {value: "campaign_activity_status_message"}
    string campaignActivityStatusMessage?;
    # The social network this profile belongs to
    string network?;
};

