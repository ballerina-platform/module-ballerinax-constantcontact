# Data indicating the status of a social network connection's integration
public type ConnectionStatusDto record {
    # Whether this social network account or the Constant Contact application is currently rate-limited by the social network provider
    @jsondata:Name {value: "rate_limited"}
    boolean rateLimited?;
    # <code>true</code> if the token for this social network is currently valid and can be successfully used to fetch data from the network
    @jsondata:Name {value: "token_is_valid"}
    boolean tokenIsValid?;
    # A user is considered active if the user has any connected profiles for the social network account
    @jsondata:Name {value: "is_active_user"}
    boolean isActiveUser?;
    # Whether the token associated with this user's social account integration has the scopes necessary to use Constant Contact social functionality
    @jsondata:Name {value: "token_has_scopes"}
    boolean tokenHasScopes?;
    # <code>true</code> if the integration has an authorization token for this social network account
    @jsondata:Name {value: "has_token"}
    boolean hasToken?;
    # A message indicating that there was an unexpected error accessing the social network account
    string 'error?;
    # The status returned from the given network's API when retrieving the account. This is typically only set when <code>error</code> is set
    int:Signed32 status?;
};

