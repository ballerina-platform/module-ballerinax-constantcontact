# Represents a social media post campaign that can include multiple posts to multiple social profiles, with either identical or network-specific content
public type PostDto record {
    # The list of per-profile posts that make up this campaign
    @jsondata:Name {value: "profile_posts"}
    ProfilePostDto[] profilePosts;
    # Campaign name for this post. The value provided on creation is sanitized before saving, so the returned value may not exactly match what was sent
    string name?;
    # The date and time to publish the post, in ISO-8601 format. Only set when <code>status</code> is <code>SCHEDULED</code>
    @jsondata:Name {value: "scheduled_time"}
    string scheduledTime?;
    # Unique identifier for the post campaign. Generated by the server on creation. Use this value to reference the post in subsequent requests
    @jsondata:Name {value: "campaign_id"}
    string campaignId?;
    # The current status of the post. Possible values include:
    # <ul>
    #   <li><code>DRAFT</code> — saved without being scheduled for publication</li>
    #   <li><code>SCHEDULED</code> — scheduled for future publication at <code>scheduled_time</code></li>
    #   <li><code>EXECUTING</code> — currently being published</li>
    #   <li><code>ACTIVE</code> — the post has been published and is active on the social network</li>
    #   <li><code>PAUSED</code> — publication has been paused</li>
    #   <li><code>SUSPENDED</code> — publication has been suspended</li>
    #   <li><code>REMOVED</code> — the post has been removed</li>
    #   <li><code>DONE</code> — publication has completed</li>
    #   <li><code>ERROR</code> — publication encountered an error</li>
    # </ul>
    string status;
};

