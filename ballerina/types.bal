# The content to post to one or more social profiles as part of a social post campaign
public type ProfilePostDto record {
    # Network-specific post settings. If no settings are provided, this field will be omitted in the JSON response. All values are persisted as strings.
    # Currently, only TikTok has available settings:
    # <pre>{
    #   "settings": {
    #     "tiktok": {
    #       "disable_comment": "true",
    #       "disable_duet": "false",
    #       "disable_stitch": "true",
    #       "auto_add_music": "false"
    #     }
    #   }
    # }</pre>
    record {|MapOfstringAndstring...;|} settings?;
    # Images to include in the post. Each image must be accessible via a public URL
    ImageDto[] images?;
    # Identifier for this post content. Generated by the server on creation. When updating a post, existing profile posts must include their original <code>post_content_id</code> unchanged
    @jsondata:Name {value: "post_content_id"}
    string postContentId?;
    # The list of profiles to post to. Can be an empty list only when the post is in <code>DRAFT</code> status
    ProfilePostProfileDto[] profiles;
    # The text/caption content for the post. Whether text is required depends on the target social network. In <code>DRAFT</code> status, this is always optional
    string text?;
};

# Additional details about a custom field in JSON format
public type CustomFieldMetadata record {
    # Determines how Constant Contact renders a <code>single_select</code> or <code> multi_select</code> field
    @jsondata:Name {value: "display_type"}
    string displayType?;
    # For type <code>number</code>, determines if a value can be negative. By default, this value is false for the type <code>number</code>
    @jsondata:Name {value: "allow_negative"}
    boolean allowNegative?;
    # Specifies the display format for date fields in the user interface. If not specified for a date type field, defaults to <code>YYYY-MM-DD</code> format. Valid only for version 2 type dates (values are stored as actual dates to support date comparisons and validations)
    @jsondata:Name {value: "display_format"}
    string displayFormat?;
    # For types <code>number</code> and <code>currency</code>, determines whether the custom field should store only whole numbers (integers) without decimal values. If the <code>integer</code> is set to <code>false</code>, the <code>decimal_places</code> must be between 1 and 4
    boolean integer?;
    # For type <code>currency</code>, specifies the three-letter currency code to assign
    @jsondata:Name {value: "currency_code"}
    string currencyCode?;
    # For types <code>number</code> and <code>currency</code>, determines the number of decimal places possible in the value
    @jsondata:Name {value: "decimal_places"}
    int decimalPlaces?;
};

