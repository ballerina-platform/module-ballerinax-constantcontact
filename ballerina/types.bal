# Represents the Queries record for the operation: listEventRegistrations
public type ListEventRegistrationsQueries record {
    # Cursor for pagination used to get the next page of results (mutually exclusive with <code>prev</code>)
    string next?;
    # Filter registration results by status
    @http:Query {name: "registration_status"}
    "PENDING"|"REGISTERED"|"CANCELED"|"EXPIRED"|"IN_PROGRESS, FAILED" registrationStatus?;
    # Filter registration results by payment status
    @http:Query {name: "payment_status"}
    "PENDING"|"PAID"|"REFUNDED"|"CANCELLED"|"FAILED"|"CHARGED_BACK" paymentStatus?;
    # Cursor for pagination used to get the previous page of results (mutually exclusive with <code>next</code>)
    string prev?;
    # Limit the number of results returned per page. If specifying both the <code>limit</code> and <code>page_size</code> query parameters, they must be the same value
    string 'limit?;
    # Specify the field to use to sort the results
    @http:Query {name: "sort_by"}
    "first_name"|"last_name"|"email_address"|"registration_status"|"payment_status"|"tickets"|"total" sortBy?;
    # Use to specify how you want the results sorted
    @http:Query {name: "sort_order"}
    "ASC"|"DESC" sortOrder?;
    # Filter registration results by first name, last name, or email address
    @http:Query {name: "search_text"}
    string searchText?;
    # Alternative to the <code>limit</code> parameter to limit the number of results returned per page. If specifying both the <code>limit</code> and <code>page_size</code> query parameters, they must be the same value
    @http:Query {name: "page_size"}
    string pageSize?;
};

# Represents the Queries record for the operation: getLandingPageUniqueContactUpdates
public type GetLandingPageUniqueContactUpdatesQueries record {
    # Use to filter the results to only include contacts that contain a certain value. This parameter does full and partial matches and applies to the contact first name, last name, and email fields. For example: Josie or Jo
    @http:Query {name: "contacts_filter"}
    string contactsFilter?;
    # Use to limit the number of contact tracking activities to return on a single page. The default is `50` and the maximum is `500` per page
    string 'limit = "50";
};

