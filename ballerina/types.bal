    string cancelledTime?;
    # Display or hide the event end time on the registration form and registration confirmation message
    @jsondata:Name {value: "display_end_time_flag"}
    boolean displayEndTimeFlag?;
    # Provides the event description
    @constraint:String {maxLength: 600}
    string description;
    @jsondata:Name {value: "default_track"}
    TrackDto defaultTrack;
    # The title for the event. The title does not have to be unique for an account
    @constraint:String {maxLength: 100}
    string title;
    # List of failed campaign activities
    @jsondata:Name {value: "failed_campaign_activities"}
    string[] failedCampaignActivities?;
    # The date the event ends
    @jsondata:Name {value: "event_end"}
    string eventEnd;
    # Identifies the event type
    @jsondata:Name {value: "event_type"}
    string eventType;
    # If `true`, sends an email to the event owner when a registration is made
    @jsondata:Name {value: "notify_owner_on_reg"}
    boolean notifyOwnerOnReg?;
    # The short code to use for the event
    @jsondata:Name {value: "event_code"}
    string eventCode?;
    ContactDto contact?;
    # The abbreviation to use to indicate the time zone where the event takes place
    @jsondata:Name {value: "time_zone_abbreviation"}
    string timeZoneAbbreviation?;
    # Display the event on the Event Calendar
    @jsondata:Name {value: "display_on_calendar_flag"}
    boolean displayOnCalendarFlag?;
    # The system assigned ID that uniquely identifies the event and is identical to the `event_id`
    @jsondata:Name {value: "campaign_id"}
    string campaignId;
    AddressDto address?;
    # The time the event was created, in ISO format. Read-only
    @jsondata:Name {value: "create_time"}
    string createTime?;
    # List of event promotions
    @jsondata:Name {value: "event_promotions"}
    EventPromotionDto[] eventPromotions?;
    # The time zone where the event takes place
    @jsondata:Name {value: "time_zone"}
    string timeZone;
    @jsondata:Name {value: "event_metadata"}
    EventMetaDataDto eventMetadata?;
    # Specifies if the event is physical and/or virtual, or to be determined
    @jsondata:Name {value: "location_type"}
    string locationType;
    # The time the event was published, in ISO format
    @jsondata:Name {value: "active_time"}
    string activeTime?;
    # The date and time the event was last modified
    @jsondata:Name {value: "last_update_time"}
    string lastUpdateTime?;
    # Display or hide event contact information on the registration form and registration confirmation message
    @jsondata:Name {value: "display_contact_flag"}
    boolean displayContactFlag?;
    # The date the event starts
    @jsondata:Name {value: "event_start"}
    string eventStart;
    # The ID that uniquely identifies the event
    @jsondata:Name {value: "event_id"}
    string eventId?;
    # The accepted currency for payments. Required for events collecting payments ['AUD','BRL','CAD','CHF','CZK','DKK','EUR','GBP','HKD','HUF','ILS','JPY','MXN','MYR','NOK','NZD','PHP','PLN','RUB','SEK','SGD','THB','TRY','TWD','USD']
    @jsondata:Name {value: "currency_type"}
    string currencyType?;
    @jsondata:Name {value: "online_meeting"}
    OnlineMeetingDto onlineMeeting?;
    # The event widget URL
    @jsondata:Name {value: "event_widget_url"}
    string eventWidgetUrl?;
    # The name of the event, has to be unique for the account
    @constraint:String {maxLength: 100, minLength: 1}
    string name;
    # The time the event was deleted, in ISO format. Read-only
    @jsondata:Name {value: "deleted_time"}
    string deletedTime?;
    # The event calendar URL
    @jsondata:Name {value: "event_calendar_url"}
    string eventCalendarUrl?;
    # Specifies the event's current status
    string status?;
};

