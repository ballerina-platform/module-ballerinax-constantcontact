# Defines when the workflow starts (e.g., list join, date-based)
public type TriggerDefDto record {
    # Engagement level for engagement_level triggers (e.g., SOMEWHAT, LEAST)
    @jsondata:Name {value: "engagement_level"}
    string engagementLevel?;
    # Action name. Required for type Action or Date. Identifies the specific trigger (e.g., list_join, calendar_date, visits_page)
    @jsondata:Name {value: "action_name"}
    string actionName?;
    # Time window for Date-type triggers. Sets when the trigger runs relative to
    # the contact's date. Uses ISO 8601 period format (e.g., P0D, P7D, P-7D).
    # | Example Scenario | after  | before |
    # |----------|--------|--------|
    # | On the day | `P0D`  | `P1D` |
    # | 7 days before | `P-7D` | `P-6D` |
    # | 7 days after | `P7D`  | `P8D` |
    TriggerDefDtoBounds bounds?;
    @jsondata:Name {value: "trigger_date"}
    TriggerDefDtoTriggerDate triggerDate?;
    # Segment ID for segment_join triggers
    @jsondata:Name {value: "segment_id"}
    string segmentId?;
    # Trigger type. Determines how the trigger is evaluated (e.g., Action, Date, segment_join)
    string 'type?;
    # List of parameters that filter or configure the trigger (e.g., list IDs for list_join)
    ParameterDto[] parameters?;
    # Deduplication key: run the workflow at most once per contact per this value (e.g., list_ids, contact_id)
    @jsondata:Name {value: "unique_by"}
    string uniqueBy?;
};

