    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # The custom field name to display in the UI (free-form text)
    @constraint:String {maxLength: 50}
    string label;
    # The data value type the custom field accepts
    @constraint:String {maxLength: 20}
    string 'type;
    # Choices available for <code>single_select</code> and <code>multi_select</code> type custom fields. The maximum number of elements for <code>radio</code> or <code>checkbox</code> display types is 20. Maximum number of elements for a <code>dropdown</code> is 100
    @constraint:Array {maxLength: 100}
    CustomFieldChoice[] choices?;
    # For <code>datetime</code> data types, this is the version number associated with the custom field
    int version?;
};

